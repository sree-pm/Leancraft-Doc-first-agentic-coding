{
  "name": "leancraft",
  "version": "0.3.0",
  "description": "Document-first, human-reviewed AI development workflow with testable contracts and portable CLI/MCP tooling",
  "type": "module",
  "bin": {
    "leancraft": "./bin/leancraft.js"
  },
  "files": [
    "bin/",
    "scripts/",
    ".leancraft/",
    ".claude/",
    ".cursor/",
    ".opencode/",
    "AGENTS.md",
    "CLAUDE.md",
    ".mcp.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:templates": "node bin/leancraft.js templates",
    "verify": "npm run test:templates && npm test && npm pack --dry-run",
    "leancraft:validate": "node scripts/leancraft-validate.mjs",
    "leancraft:sync": "node scripts/leancraft-sync.mjs",
    "leancraft:doctor": "node scripts/leancraft-doctor.mjs",
    "test:contracts": "node --test test/*.test.mjs"
  },
  "keywords": [
    "doc-first",
    "agentic-coding",
    "claude-code",
    "cursor",
    "opencode",
    "mcp",
    "spec-driven",
    "ai-development"
  ],
  "author": "sree-pm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sree-pm/Leancraft-Doc-first-agentic-coding.git"
  },
  "homepage": "https://github.com/sree-pm/Leancraft-Doc-first-agentic-coding#readme",
  "bugs": {
    "url": "https://github.com/sree-pm/Leancraft-Doc-first-agentic-coding/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
